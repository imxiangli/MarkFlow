# MarkFlow update server (Caddy 2).
#
# MARKFLOW_SITE decides how Caddy listens:
#   updates.example.com  → automatic HTTPS (Let's Encrypt) on ports 80/443  ← production
#   :80                  → plain HTTP (local testing, or behind another TLS proxy)
#
# The feed is served under /markflow/, so the app's update URL is
#   https://updates.example.com/markflow/

{$MARKFLOW_SITE::80} {
	# Health check for load balancers / monitoring.
	handle /healthz {
		respond "ok" 200
	}

	handle_path /markflow/* {
		root * /srv/markflow

		# The manifest must always be revalidated; everything else is content-addressed
		# or versioned and never changes once uploaded.
		@manifest path /latest.json /latest.json.sig
		header @manifest Cache-Control "no-cache"
		@immutable path /files/* /full/* /versions/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff

		# Compress JSON only. The .gz blobs and installers must be sent byte-for-byte.
		@json path *.json
		encode @json gzip

		file_server
	}

	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format console
	}
}
