{
  "name": "markflow",
  "productName": "MarkFlow",
  "version": "1.0.0",
  "description": "A cross-platform Markdown reader & editor with folder workspace, live preview, math, diagrams and more.",
  "main": "./out/main/bootstrap.js",
  "author": {
    "name": "MarkFlow"
  },
  "license": "MIT",
  "homepage": "https://github.com/imxiangli/MarkFlow",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:md": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/markdown.test.ts",
    "test:keys": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/shortcuts.test.ts",
    "test:text": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/textfile.test.ts",
    "test:watch": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/watcher.test.ts",
    "test:paste": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/paste.test.ts",
    "test:largefile": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/largefile.test.ts",
    "test:type": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/contentType.test.ts",
    "test:table": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/table.test.ts",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "test:update": "node tests/update-e2e.mjs",
    "test:recovery": "node tests/recovery-e2e.mjs",
    "test:reading": "node tests/reading-e2e.mjs",
    "test:shortcuts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/shortcuts-e2e.mjs",
    "test:files": "node tests/files-e2e.mjs",
    "test:large": "node tests/large-folder-e2e.mjs",
    "test:paste-e2e": "node tests/paste-e2e.mjs",
    "test:find": "node tests/find-e2e.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "docs:shortcuts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-shortcuts.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:update": "node scripts/release-update.mjs",
    "deploy:update": "node scripts/deploy-update.mjs",
    "verify:update": "node scripts/verify-update-server.mjs",
    "update-server": "node server/update-server.mjs",
    "update:keygen": "node scripts/update-keygen.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@viz-js/viz": "^3.31.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "iconv-lite": "^0.6.3",
    "js-yaml": "^5.5.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.59.0",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.2.0",
    "morphdom": "^2.7.8",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "markflow": {
    "github": "imxiangli/MarkFlow",
    "updateUrl": ""
  }
}
